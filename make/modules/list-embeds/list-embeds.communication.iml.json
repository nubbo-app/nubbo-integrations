{
	"url": "/embeds",
	"method": "GET",
	"qs": {
		"kind": "{{ifempty(parameters.kind, undefined)}}",
		"status": "{{ifempty(parameters.status, undefined)}}",
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'expiresAt', 'createdAt', 'updatedAt')}}",
			"expiresAt": "{{if(item.expiresAt, parseDate(item.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.expiresAt)}}",
			"createdAt": "{{parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"updatedAt": "{{parseDate(item.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
