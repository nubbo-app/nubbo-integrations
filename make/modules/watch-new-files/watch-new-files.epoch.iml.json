{
	"url": "/activity",
	"method": "GET",
	"qs": {
		"types": "FILE_UPLOADED,FILE_REQUEST_RECEIVED,EMBED_FILE_UPLOADED",
		"bucketId": "{{ifempty(parameters.bucketId, undefined)}}",
		"limit": 50
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"date": "{{parseDate(item.occurredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"label": "{{formatDate(item.occurredAt, 'YYYY-MM-DD HH:mm')}} · {{ifempty(item.file.path, item.type)}}"
		},
		"limit": 50
	}
}
