{
	"temp": {
		"since": "{{if(contains(ifempty(data.lastId, emptystring), '|'), last(split(data.lastId, '|')), undefined)}}"
	},
	"url": "/triggers/new-files",
	"method": "GET",
	"headers": {
		"X-Nubbo-Flow": "make:{{scenario.id}}"
	},
	"qs": {
		"bucketId": "{{ifempty(parameters.bucketId, undefined)}}",
		"prefix": "{{ifempty(parameters.prefix, undefined)}}",
		"since": "{{temp.since}}"
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'occurredAt')}}",
			"occurredAt": "{{if(item.occurredAt, parseDate(item.occurredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.occurredAt)}}",
			"madeByThisKey": "{{item.actor.apiKey.id == connection.keyId}}"
		},
		"limit": "{{ifempty(parameters.limit, 100)}}",
		"trigger": {
			"type": "date",
			"order": "unordered",
			"id": "{{substring(toString(if(temp.since, 100000 + indexOf(join(map(body.data, 'id'), ','), item.id), 199999 - indexOf(join(map(body.data, 'id'), ','), item.id))), 1, 6)}}|{{item.id}}|{{item.cursor}}",
			"date": "{{if(temp.since, addSeconds(now, indexOf(join(map(body.data, 'id'), ','), item.id) / 1000), parseDate(item.occurredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'))}}"
		}
	}
}
