{
	"url": "/automations",
	"method": "GET",
	"qs": {
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'lastRunAt', 'createdAt')}}",
			"lastRunAt": "{{if(item.lastRunAt, parseDate(item.lastRunAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.lastRunAt)}}",
			"createdAt": "{{if(item.createdAt, parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.createdAt)}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
