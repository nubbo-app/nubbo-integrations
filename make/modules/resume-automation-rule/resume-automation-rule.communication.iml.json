{
	"url": "/automations/{{parameters.ruleId}}/resume",
	"method": "POST",
	"body": {},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'lastRunAt', 'createdAt')}}",
			"lastRunAt": "{{if(body.lastRunAt, parseDate(body.lastRunAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.lastRunAt)}}",
			"createdAt": "{{parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
		}
	}
}
