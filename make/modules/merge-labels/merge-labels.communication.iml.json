{
	"url": "/labels/{{parameters.labelId}}/merge",
	"method": "POST",
	"body": {
		"{{...}}": "{{omit(parameters, 'labelId')}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'label')}}",
			"label": {
				"{{...}}": "{{omit(body.label, 'createdAt', 'updatedAt')}}",
				"createdAt": "{{parseDate(body.label.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
				"updatedAt": "{{parseDate(body.label.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
			}
		}
	}
}
