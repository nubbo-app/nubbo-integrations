{
	"url": "/embeds",
	"method": "POST",
	"body": {
		"{{...}}": "{{omit(parameters, 'path')}}",
		"path": "{{ifempty(parameters.path, emptystring)}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'expiresAt', 'createdAt', 'updatedAt')}}",
			"expiresAt": "{{if(body.expiresAt, parseDate(body.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.expiresAt)}}",
			"createdAt": "{{parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"updatedAt": "{{parseDate(body.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
		}
	}
}
