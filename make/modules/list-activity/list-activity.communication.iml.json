{
	"url": "/activity",
	"method": "GET",
	"qs": {
		"types": "{{ifempty(join(ifempty(parameters.types, emptyarray), ','), undefined)}}",
		"bucketId": "{{ifempty(parameters.bucketId, undefined)}}",
		"apiKeyId": "{{ifempty(parameters.apiKeyId, undefined)}}",
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'occurredAt')}}",
			"occurredAt": "{{parseDate(item.occurredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
