{
	"url": "/galleries/{{parameters.galleryId}}",
	"method": "PATCH",
	"body": {
		"{{...}}": "{{omit(parameters, 'clear', 'galleryId', 'title', 'layout')}}",
		"title": "{{ifempty(parameters.title, undefined)}}",
		"layout": "{{ifempty(parameters.layout, undefined)}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'expiresAt', 'createdAt', 'updatedAt')}}",
			"expiresAt": "{{if(body.expiresAt, parseDate(body.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.expiresAt)}}",
			"createdAt": "{{if(body.createdAt, parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.createdAt)}}",
			"updatedAt": "{{if(body.updatedAt, parseDate(body.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.updatedAt)}}"
		}
	}
}
