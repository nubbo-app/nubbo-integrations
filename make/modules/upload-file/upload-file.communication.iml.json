[
	{
		"url": "/buckets/{{parameters.bucketId}}/uploads",
		"method": "POST",
		"body": {
			"path": "{{if(parameters.folder, replace(parameters.folder, '/^\\/+|\\/+$/g', emptystring) + '/', emptystring)}}{{parameters.fileName}}",
			"size": "{{length(parameters.data)}}",
			"contentType": "{{ifempty(parameters.contentType, undefined)}}",
			"conflict": "{{ifempty(parameters.conflict, undefined)}}"
		},
		"response": {
			"temp": {
				"uploadId": "{{body.uploadId}}",
				"url": "{{body.url}}",
				"method": "{{body.method}}"
			}
		}
	},
	{
		"url": "{{temp.url}}",
		"encodeUrl": false,
		"method": "{{temp.method}}",
		"type": "binary",
		"headers": {
			"Authorization": "{{undefined}}",
			"Content-Type": "{{ifempty(parameters.contentType, 'application/octet-stream')}}"
		},
		"body": "{{parameters.data}}",
		"response": {
			"error": {
				"message": "[{{statusCode}}] The storage provider refused the upload: {{toString(body)}}",
				"400": {
					"type": "DataError",
					"message": "[400] The storage provider refused the upload: {{toString(body)}}"
				},
				"401": {
					"type": "DataError",
					"message": "[401] The storage provider refused the upload: {{toString(body)}}"
				},
				"403": {
					"type": "DataError",
					"message": "[403] The storage provider refused the upload: {{toString(body)}}"
				},
				"404": {
					"type": "DataError",
					"message": "[404] The storage provider refused the upload: {{toString(body)}}"
				},
				"429": {
					"type": "RateLimitError",
					"message": "[429] The storage provider refused the upload: {{toString(body)}}"
				}
			}
		}
	},
	{
		"url": "/uploads/{{temp.uploadId}}/complete",
		"method": "POST",
		"body": {},
		"response": {
			"output": {
				"{{...}}": "{{omit(body, 'modifiedAt', 'trashedAt')}}",
				"modifiedAt": "{{if(body.modifiedAt, parseDate(body.modifiedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.modifiedAt)}}",
				"trashedAt": "{{if(body.trashedAt, parseDate(body.trashedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.trashedAt)}}"
			}
		}
	}
]
