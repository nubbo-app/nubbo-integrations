{
	"url": "/automations/{{parameters.ruleId}}",
	"method": "PATCH",
	"body": {
		"{{...}}": "{{omit(parameters, 'clear', 'ruleId', 'name', 'fileRequestId', 'folderPrefix', 'interval', 'destinationFolder', 'routeFallbackFolder', 'trashOlderThanDays', 'compressDestinationFolder', 'prompt', 'promptOutput', 'copyDestBucketId', 'copyDestinationFolder', 'copyMode', 'shareExpiresInDays', 'shareMaxDownloads', 'thresholdGb', 'inactivityDays', 'routeCategories', 'namePattern', 'sharePassword', 'ruleTrigger', 'ruleAction')}}",
		"name": "{{ifempty(parameters.name, undefined)}}",
		"fileRequestId": "{{ifempty(parameters.fileRequestId, undefined)}}",
		"folderPrefix": "{{ifempty(parameters.folderPrefix, undefined)}}",
		"interval": "{{ifempty(parameters.interval, undefined)}}",
		"destinationFolder": "{{ifempty(parameters.destinationFolder, undefined)}}",
		"routeFallbackFolder": "{{ifempty(parameters.routeFallbackFolder, undefined)}}",
		"trashOlderThanDays": "{{ifempty(parameters.trashOlderThanDays, undefined)}}",
		"compressDestinationFolder": "{{ifempty(parameters.compressDestinationFolder, undefined)}}",
		"prompt": "{{ifempty(parameters.prompt, undefined)}}",
		"promptOutput": "{{ifempty(parameters.promptOutput, undefined)}}",
		"copyDestBucketId": "{{ifempty(parameters.copyDestBucketId, undefined)}}",
		"copyDestinationFolder": "{{ifempty(parameters.copyDestinationFolder, undefined)}}",
		"copyMode": "{{ifempty(parameters.copyMode, undefined)}}",
		"shareExpiresInDays": "{{ifempty(parameters.shareExpiresInDays, undefined)}}",
		"shareMaxDownloads": "{{ifempty(parameters.shareMaxDownloads, undefined)}}",
		"thresholdGb": "{{ifempty(parameters.thresholdGb, undefined)}}",
		"inactivityDays": "{{ifempty(parameters.inactivityDays, undefined)}}",
		"routeCategories": "{{ifempty(parameters.routeCategories, undefined)}}",
		"namePattern": "{{if(contains(keys(parameters), 'namePattern'), ifempty(parameters.namePattern, emptystring), undefined)}}",
		"sharePassword": "{{if(contains(keys(parameters), 'sharePassword'), ifempty(parameters.sharePassword, emptystring), undefined)}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'lastRunAt', 'createdAt')}}",
			"lastRunAt": "{{if(body.lastRunAt, parseDate(body.lastRunAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.lastRunAt)}}",
			"createdAt": "{{if(body.createdAt, parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.createdAt)}}"
		}
	}
}
