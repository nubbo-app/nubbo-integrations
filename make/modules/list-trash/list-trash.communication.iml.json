{
	"url": "/trash",
	"method": "GET",
	"qs": {
		"bucketId": "{{ifempty(parameters.bucketId, undefined)}}",
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'modifiedAt', 'trashedAt')}}",
			"modifiedAt": "{{if(item.modifiedAt, parseDate(item.modifiedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.modifiedAt)}}",
			"trashedAt": "{{if(item.trashedAt, parseDate(item.trashedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.trashedAt)}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
