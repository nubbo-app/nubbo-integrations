{
	"url": "/projects",
	"method": "GET",
	"qs": {
		"status": "{{ifempty(parameters.status, undefined)}}",
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'createdAt', 'lastActivityAt')}}",
			"createdAt": "{{if(item.createdAt, parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.createdAt)}}",
			"lastActivityAt": "{{if(item.lastActivityAt, parseDate(item.lastActivityAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.lastActivityAt)}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
