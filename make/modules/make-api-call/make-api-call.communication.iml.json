{
	"url": "https://api.nubbo.app/{{replace(replace(parameters.url, '/^\\/+/', emptystring), '/^(?!v1(\\/|$))/', 'v1/')}}",
	"method": "{{parameters.method}}",
	"headers": {
		"{{...}}": "{{toCollection(ifempty(parameters.headers, emptyarray), 'key', 'value')}}"
	},
	"qs": {
		"{{...}}": "{{toCollection(ifempty(parameters.qs, emptyarray), 'key', 'value')}}"
	},
	"body": "{{parameters.body}}",
	"type": "text",
	"response": {
		"output": {
			"body": "{{body}}",
			"headers": "{{headers}}",
			"statusCode": "{{statusCode}}"
		}
	}
}
