{
	"url": "/projects/{{parameters.projectId}}",
	"method": "GET",
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'createdAt', 'lastActivityAt')}}",
			"createdAt": "{{if(body.createdAt, parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.createdAt)}}",
			"lastActivityAt": "{{if(body.lastActivityAt, parseDate(body.lastActivityAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.lastActivityAt)}}"
		}
	}
}
