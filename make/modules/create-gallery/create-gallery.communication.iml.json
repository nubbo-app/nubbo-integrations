{
	"url": "/galleries",
	"method": "POST",
	"headers": {
		"Authorization": "Bearer {{connection.apiKey}}"
	},
	"body": {
		"fileId": "{{ifempty(parameters.fileId, undefined)}}",
		"title": "{{ifempty(parameters.title, undefined)}}",
		"description": "{{ifempty(parameters.description, undefined)}}",
		"layout": "{{ifempty(parameters.layout, undefined)}}",
		"coverFileId": "{{ifempty(parameters.coverFileId, undefined)}}",
		"individualDownloads": "{{parameters.individualDownloads}}",
		"zipDownload": "{{parameters.zipDownload}}",
		"password": "{{ifempty(parameters.password, undefined)}}",
		"expiresAt": "{{if(parameters.expiresAt, formatDate(parameters.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined)}}",
		"watermarkText": "{{ifempty(parameters.watermarkText, undefined)}}"
	},
	"response": {
		"output": "{{body}}"
	}
}
