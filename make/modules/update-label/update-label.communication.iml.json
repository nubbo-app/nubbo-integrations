{
	"url": "/labels/{{parameters.labelId}}",
	"method": "PATCH",
	"body": {
		"{{...}}": "{{omit(parameters, 'clear', 'labelId', 'name', 'color', 'description')}}",
		"name": "{{ifempty(parameters.name, undefined)}}",
		"color": "{{ifempty(parameters.color, undefined)}}",
		"description": "{{if(contains(keys(parameters), 'description'), ifempty(parameters.description, emptystring), undefined)}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'createdAt', 'updatedAt')}}",
			"createdAt": "{{if(body.createdAt, parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.createdAt)}}",
			"updatedAt": "{{if(body.updatedAt, parseDate(body.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.updatedAt)}}"
		}
	}
}
