{
	"url": "/inboxes/{{parameters.inboxId}}/uploads",
	"method": "GET",
	"qs": {
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'uploadedAt')}}",
			"uploadedAt": "{{if(item.uploadedAt, parseDate(item.uploadedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.uploadedAt)}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
