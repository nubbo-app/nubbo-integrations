{
	"url": "/operations/{{parameters.operationId}}",
	"method": "GET",
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'createdAt', 'startedAt', 'finishedAt')}}",
			"createdAt": "{{parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"startedAt": "{{if(body.startedAt, parseDate(body.startedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.startedAt)}}",
			"finishedAt": "{{if(body.finishedAt, parseDate(body.finishedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.finishedAt)}}"
		}
	}
}
