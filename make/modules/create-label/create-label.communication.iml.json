{
	"url": "/labels",
	"method": "POST",
	"headers": {
		"Authorization": "Bearer {{connection.apiKey}}"
	},
	"body": {
		"name": "{{ifempty(parameters.name, undefined)}}",
		"color": "{{ifempty(parameters.color, undefined)}}",
		"description": "{{ifempty(parameters.description, undefined)}}",
		"groupId": "{{ifempty(parameters.groupId, undefined)}}"
	},
	"response": {
		"output": "{{body}}"
	}
}
