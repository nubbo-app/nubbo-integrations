{
	"url": "/me",
	"method": "GET",
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'key', 'quota')}}",
			"key": {
				"{{...}}": "{{omit(body.key, 'expiresAt')}}",
				"expiresAt": "{{if(body.key.expiresAt, parseDate(body.key.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.key.expiresAt)}}"
			},
			"quota": {
				"{{...}}": "{{omit(body.quota, 'periodStart', 'periodEnd')}}",
				"periodStart": "{{parseDate(body.quota.periodStart, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
				"periodEnd": "{{parseDate(body.quota.periodEnd, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
			}
		}
	}
}
