{
	"url": "/inboxes/{{parameters.inboxId}}",
	"method": "PATCH",
	"body": {
		"{{...}}": "{{omit(parameters, 'inboxId', 'name', 'path', 'visitorIdentity', 'allowedFileTypes')}}",
		"name": "{{ifempty(parameters.name, undefined)}}",
		"path": "{{ifempty(parameters.path, undefined)}}",
		"visitorIdentity": "{{ifempty(parameters.visitorIdentity, undefined)}}",
		"allowedFileTypes": "{{if(contains(keys(parameters), 'allowedFileTypes'), ifempty(parameters.allowedFileTypes, emptyarray), undefined)}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'expiresAt', 'createdAt', 'updatedAt')}}",
			"expiresAt": "{{if(body.expiresAt, parseDate(body.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.expiresAt)}}",
			"createdAt": "{{parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"updatedAt": "{{parseDate(body.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
		}
	}
}
