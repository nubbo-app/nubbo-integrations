{
	"url": "/inboxes/{{parameters.inboxId}}",
	"method": "PATCH",
	"headers": {
		"Authorization": "Bearer {{connection.apiKey}}"
	},
	"body": {
		"name": "{{ifempty(parameters.name, undefined)}}",
		"description": "{{if(contains(ifempty(parameters.clear, emptyarray), 'description'), null, ifempty(parameters.description, undefined))}}",
		"path": "{{ifempty(parameters.path, undefined)}}",
		"password": "{{if(contains(ifempty(parameters.clear, emptyarray), 'password'), null, ifempty(parameters.password, undefined))}}",
		"expiresAt": "{{if(contains(ifempty(parameters.clear, emptyarray), 'expiresAt'), null, if(parameters.expiresAt, formatDate(parameters.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), undefined))}}",
		"maxFileSize": "{{if(contains(ifempty(parameters.clear, emptyarray), 'maxFileSize'), null, ifempty(parameters.maxFileSize, undefined))}}",
		"allowedFileTypes": "{{if(contains(ifempty(parameters.clear, emptyarray), 'allowedFileTypes'), emptyarray, ifempty(parameters.allowedFileTypes, undefined))}}",
		"maxUploads": "{{if(contains(ifempty(parameters.clear, emptyarray), 'maxUploads'), null, ifempty(parameters.maxUploads, undefined))}}",
		"visitorIdentity": "{{ifempty(parameters.visitorIdentity, undefined)}}",
		"active": "{{parameters.active}}"
	},
	"response": {
		"output": "{{body}}"
	}
}
