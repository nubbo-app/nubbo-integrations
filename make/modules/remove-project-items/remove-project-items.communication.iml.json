{
	"url": "/projects/{{parameters.projectId}}/items",
	"method": "DELETE",
	"body": {
		"{{...}}": "{{omit(parameters, 'projectId')}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'createdAt', 'lastActivityAt')}}",
			"createdAt": "{{parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"lastActivityAt": "{{if(body.lastActivityAt, parseDate(body.lastActivityAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.lastActivityAt)}}"
		}
	}
}
