{
	"url": "/files/{{parameters.fileId}}",
	"method": "GET",
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'modifiedAt', 'trashedAt')}}",
			"modifiedAt": "{{if(body.modifiedAt, parseDate(body.modifiedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.modifiedAt)}}",
			"trashedAt": "{{if(body.trashedAt, parseDate(body.trashedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.trashedAt)}}"
		}
	}
}
