{
	"url": "/files/{{parameters.fileId}}/download-link",
	"method": "POST",
	"body": {
		"{{...}}": "{{omit(parameters, 'fileId')}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'expiresAt')}}",
			"expiresAt": "{{if(body.expiresAt, parseDate(body.expiresAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.expiresAt)}}"
		}
	}
}
