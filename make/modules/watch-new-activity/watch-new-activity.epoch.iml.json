{
	"url": "/activity",
	"method": "GET",
	"headers": {
		"Authorization": "Bearer {{connection.apiKey}}"
	},
	"qs": {
		"types": "{{ifempty(join(ifempty(parameters.types, emptyarray), ','), undefined)}}",
		"limit": 50
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"date": "{{item.occurredAt}}",
			"label": "{{formatDate(item.occurredAt, 'YYYY-MM-DD HH:mm')}} · {{ifempty(item.file.path, item.type)}}"
		},
		"limit": 50
	}
}
