{
	"url": "/label-groups",
	"method": "GET",
	"qs": {
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'createdAt', 'updatedAt')}}",
			"createdAt": "{{parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}",
			"updatedAt": "{{parseDate(item.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
