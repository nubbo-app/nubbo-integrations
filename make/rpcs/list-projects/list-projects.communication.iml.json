{
	"url": "/projects",
	"method": "GET",
	"headers": {
		"Authorization": "Bearer {{connection.apiKey}}"
	},
	"qs": {
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"label": "{{item.name}}",
			"value": "{{item.id}}"
		},
		"limit": 300
	},
	"pagination": {
		"qs": {
			"limit": 100,
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
