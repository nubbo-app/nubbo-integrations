{
	"url": "/embeds",
	"method": "GET",
	"qs": {
		"limit": 100
	},
	"response": {
		"iterate": "{{body.data}}",
		"output": {
			"label": "{{ifempty(item.name, item.kind)}}",
			"value": "{{item.id}}"
		},
		"limit": 300
	},
	"pagination": {
		"qs": {
			"cursor": "{{body.nextCursor}}"
		},
		"condition": "{{body.nextCursor}}"
	}
}
