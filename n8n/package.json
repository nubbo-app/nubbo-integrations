{
	"name": "n8n-nodes-nubbo",
	"version": "0.2.1",
	"description": "One workspace for all your S3 storage. Automate it from n8n.",
	"license": "MIT",
	"homepage": "https://github.com/nubbo-app/nubbo-integrations/tree/main/n8n#readme",
	"keywords": [
		"n8n-community-node-package",
		"nubbo",
		"s3",
		"object storage"
	],
	"author": {
		"name": "Nubbo",
		"email": "info@nubbo.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nubbo-app/nubbo-integrations.git",
		"directory": "n8n"
	},
	"bugs": {
		"url": "https://github.com/nubbo-app/nubbo-integrations/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NubboApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Nubbo/Nubbo.node.js",
			"dist/nodes/Nubbo/NubboTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
